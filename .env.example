# AgentArena v0.2 local settings. The launcher loads .env automatically.
# Easier: run .venv/bin/python scripts/setup_openrouter.py after start.py --check.
# Do not put your provider key in the browser's workspace-token field.
ARENA_DATA_DIR=.arena
ARENA_WORKERS=1
ARENA_CALL_INTERVAL_SECONDS=3.2
ARENA_READ_ONLY=0
# Optional write-protection token, separate from your provider key:
ARENA_API_TOKEN=
# Compatibility variable names: an OpenRouter key goes in OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Select a specific current model supporting tools; don't use an automatic model router.
OPENAI_MODEL=
# USD / million tokens for the configured model only. Wizard uses live catalogue prices.
# Provider-reported OpenRouter usage.cost is preferred when available.
ARENA_INPUT_PRICE=
ARENA_OUTPUT_PRICE=
